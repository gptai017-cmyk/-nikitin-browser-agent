{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paycoin-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "CHANNEL_ID": "@paycoin",
    "AUTOPOST_ENABLED": "false"
  },
  "triggers": { "crons": ["30 12 * * 1,3,5"] }
}