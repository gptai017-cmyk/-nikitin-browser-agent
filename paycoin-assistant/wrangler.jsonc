{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paycoin-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "CHANNEL_ID": "@paycoin",
    "AUTOPOST_ENABLED": "false",
    "PUBLIC_WORKER_URL": "https://paycoin-assistant.cbd-legal-cloudflare-worker.workers.dev"
  },
  "triggers": { "crons": ["*/5 * * * *", "30 12 * * 1,3,5"] }
}