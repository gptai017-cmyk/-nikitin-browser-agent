{
  "name": "pravo4u-max",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROBO_ORDERS",
        "class_name": "RoboOrders"
      },
      {
        "name": "MAX_CHANNEL_STATE",
        "class_name": "MaxChannelRegistry"
      },
      {
        "name": "MAX_MIRROR_STATE",
        "class_name": "MirrorState"
      },
      {
        "name": "LEX_GROWTH_TOTALS",
        "class_name": "GrowthTotals"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-anon-robokassa",
      "new_sqlite_classes": [
        "RoboOrders"
      ]
    },
    {
      "tag": "v2-max-public-channel-state",
      "new_sqlite_classes": [
        "MaxChannelRegistry"
      ]
    },
    {
      "tag": "v3-max-public-tg-mirror",
      "new_sqlite_classes": [
        "MirrorState"
      ]
    },
    {
      "tag": "v4-lex-aggregate-growth",
      "new_sqlite_classes": [
        "GrowthTotals"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
