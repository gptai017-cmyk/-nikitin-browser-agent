limit_req_zone $binary_remote_addr zone=lex_security:10m rate=10r/m;

server {
    listen 443 ssl http2;
    server_name __RUSSIAN_INTAKE_HOST__;

    ssl_certificate     /etc/letsencrypt/live/__RUSSIAN_INTAKE_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__RUSSIAN_INTAKE_HOST__/privkey.pem;

    client_max_body_size 8k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location /v1/ {
        limit_req zone=lex_security burst=10 nodelay;
        proxy_pass http://127.0.0.1:8099;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass_request_headers on;
    }
}
